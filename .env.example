# Pintorex Construction - Environment Variables
# Copy this file to .env and fill in the values

# Password hash (generate with: node -e "require('bcrypt').hash('yourpassword', 10).then(console.log)")
PASSWORD_HASH=

# Session secret (use a random 32+ character string)
SESSION_SECRET=

# Environment (development or production)
NODE_ENV=production

# Port (Render sets this automatically in production)
PORT=3000

# Supabase Configuration (for document verification)
# Get these from your Supabase project settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# EmailJS Configuration (get from emailjs.com dashboard)
# Note: These are used client-side, not server-side
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
